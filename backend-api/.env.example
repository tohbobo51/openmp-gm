# Salin ke .env lokal dan isi nilai hanya pada host privat; jangan commit file .env.
PORT=3000
DB_HOST=YOUR_DATABASE_HOST
DB_PORT=3306
DB_USER=YOUR_DATABASE_USER
DB_PASS=REPLACE_WITH_ROTATED_DATABASE_PASSWORD
DB_NAME=YOUR_DATABASE_NAME

# Web OAuth Client ID dalam project Google yang sama dengan OAuth Android client.
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
